<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.3.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AssemblyName>Finesse.Empostor.Plugin</AssemblyName>
    <RootNamespace>Finesse.Plugin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Empostor.Api" Version="2.1.0-ci.648" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(NuGetPackageRoot)moonsharp/2.0.0/lib/netstandard1.6/MoonSharp.Interpreter.dll">
      <LogicalName>Finesse.Plugin.Dependencies.MoonSharp.Interpreter.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
