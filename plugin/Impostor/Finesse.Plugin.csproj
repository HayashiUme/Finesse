<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.3.1-dev</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AssemblyName>Finesse.Plugin</AssemblyName>
    <RootNamespace>Finesse.Plugin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ImpostorApiProject)" Condition="'$(ImpostorApiProject)' != ''" />
    <ProjectReference Include="../../../Impostor/src/Impostor.Api/Impostor.Api.csproj" Condition="'$(ImpostorApiProject)' == '' and Exists('../../../Impostor/src/Impostor.Api/Impostor.Api.csproj')" />
    <!-- Allow building outside the Impostor source tree (CI / release builds). -->
    <PackageReference Include="Impostor.Api" Version="1.10.10" Condition="'$(ImpostorApiProject)' == '' and !Exists('../../../Impostor/src/Impostor.Api/Impostor.Api.csproj')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(NuGetPackageRoot)moonsharp/2.0.0/lib/netstandard1.6/MoonSharp.Interpreter.dll">
      <LogicalName>Finesse.Plugin.Dependencies.MoonSharp.Interpreter.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
